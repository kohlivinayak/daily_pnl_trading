# Copy to .env for a local run (npm run dev). On Vercel, set these under
# Project -> Settings -> Environment Variables instead. Never commit .env.
JSONBIN_BIN_ID=
JSONBIN_KEY=
JSONBIN_KEY_TYPE=access
# "Name:hash;Name:hash" — make each line with: node scripts/passkey-hash.js <Name> <passkey>
PASSKEY_HASHES=
# Keep "false" until you have checked the new site with live data
WRITES_ENABLED=false
# classic = old site at /, new at /new   ·   new = new site at /, old at /classic
SITE_MODE=classic
